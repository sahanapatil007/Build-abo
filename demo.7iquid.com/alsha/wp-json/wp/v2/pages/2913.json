ta-id=\"a5c7fe6\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"alsha_sub_title.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"alsha-sub-title-el\">\r\n    <div class=\"sub-title-wrap\">     \r\n        <span class=\"sub-title-text\"><span class=\"icon-wrap\"><svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"11\" height=\"10\" viewBox=\"0 0 11 10\" fill=\"none\"><rect x=\"4.23438\" width=\"1.78428\" height=\"3.56855\" fill=\"black\"><\/rect><rect x=\"4.23438\" y=\"6.40979\" width=\"1.78428\" height=\"3.56855\" fill=\"black\"><\/rect><rect x=\"6.68359\" y=\"4.09705\" width=\"3.56855\" height=\"1.78428\" fill=\"black\"><\/rect><rect y=\"4.09705\" width=\"3.56855\" height=\"1.78428\" fill=\"black\"><\/rect><\/svg><\/span>how we work<span class=\"icon-wrap\"><svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"11\" height=\"10\" viewBox=\"0 0 11 10\" fill=\"none\"><rect x=\"4.23438\" width=\"1.78428\" height=\"3.56855\" fill=\"black\"><\/rect><rect x=\"4.23438\" y=\"6.40979\" width=\"1.78428\" height=\"3.56855\" fill=\"black\"><\/rect><rect x=\"6.68359\" y=\"4.09705\" width=\"3.56855\" height=\"1.78428\" fill=\"black\"><\/rect><rect y=\"4.09705\" width=\"3.56855\" height=\"1.78428\" fill=\"black\"><\/rect><\/svg><\/span><\/span>    <\/div>\r\n<\/div>\r\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-b2abceb elementor-widget elementor-widget-alsha_title\" data-id=\"b2abceb\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"alsha_title.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"alsha-title-el\" data-split=\"none\" data-animate=\"none\" data-delay=\"0\" data-animateDuration=\"0.8\" data-stagger=\"0\" data-ease=\"none\">\r\n    <h2 class=\"title-text\">Our Working Process<\/h2><\/div>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-2b49543 e-con-full e-flex e-con e-child\" data-id=\"2b49543\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-87da381 elementor-widget elementor-widget-alsha_process\" data-id=\"87da381\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"alsha_process.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"alsha-process-el layout-1\"> \n            <div class=\"process-item\"> \n            <div class=\"item-count\">01<\/div>\n            <div class=\"featured-image\"><img loading=\"lazy\" decoding=\"async\" width=\"736\" height=\"1104\" src=\"https:\/\/demo.7iquid.com\/alsha\/wp-content\/uploads\/2026\/05\/processImage01.webp\" class=\"attachment-full size-full wp-image-2936\" alt=\"\" srcset=\"https:\/\/demo.7iquid.com\/alsha\/wp-content\/uploads\/2026\/05\/processImage01.webp 736w, https:\/\/demo.7iquid.com\/alsha\/wp-content\/uploads\/2026\/05\/processImage01-200x300.webp 200w, https:\/\/demo.7iquid.com\/alsha\/wp-content\/uploads\/2026\/05\/processImage01-683x1024.webp 683w, https:\/\/demo.7iquid.com\/alsha\/wp-content\/uploads\/2026\/05\/processImage01-373x560.webp 373w\" sizes=\"(max-width: 736px) 100vw, 736px\" \/><\/div>\n            <div class=\"item-content-wrap\">\n                <div class=\"item-title\">Research &amp; Strategy<\/div>\n                <div class=\"item-description\">We explore the cultural, spatial, and environmental context to establish a clear design direction and strategic foundation for each project.<\/div>\n                <div class=\"item-list\"><ul>\n<li>Site &amp; Context Analysis<\/li>\n<li>Program Definition &amp; Spatial Strategy<\/li>\n<li>Architectural Concept Framework<\/li>\n<\/ul><\/div>\n            <\/div>\n        <\/div>\n            <div class=\"process-item\"> \n            <div class=\"item-count\">02<\/div>\n            <div class=\"featured-image\"><img loading=\"lazy\" decoding=\"async\" width=\"736\" height=\"981\" src=\"https:\/\/demo.7iquid.com\/alsha\/wp-content\/uploads\/2026\/05\/serviceImage06.webp\" class=\"attachment-full size-full wp-image-2220\" alt=\"\" srcset=\"https:\/\/demo.7iquid.com\/alsha\/wp-content\/uploads\/2026\/05\/serviceImage06.webp 736w, https:\/\/demo.7iquid.com\/alsha\/wp-content\/uploads\/2026\/05\/serviceImage06-225x300.webp 225w, https:\/\/demo.7iquid.com\/alsha\/wp-content\/uploads\/2026\/05\/serviceImage06-420x560.webp 420w\" sizes=\"(max-width: 736px) 100vw, 736px\" \/><\/div>\n            <div class=\"item-content-wrap\">\n                <div class=\"item-title\">Design Development<\/div>\n                <div class=\"item-description\">Initial concepts are gradually transformed into cohesive spatial systems. The design is explored, tested, and refined through multiple iterations.<\/div>\n                <div class=\"item-list\"><ul>\n<li>Spatial Planning &amp; Design Development<\/li>\n<li>Material &amp; Detail Exploration<\/li>\n<li>Technical Coordination &amp; Documentation<\/li>\n<\/ul><\/div>\n            <\/div>\n        <\/div>\n            <div class=\"process-item\"> \n            <div class=\"item-count\">03<\/div>\n            <div class=\"featured-image\"><img loading=\"lazy\" decoding=\"async\" width=\"736\" height=\"1068\" src=\"https:\/\/demo.7iquid.com\/alsha\/wp-content\/uploads\/2026\/05\/testimonialImage.webp\" class=\"attachment-full size-full wp-image-1919\" alt=\"\" srcset=\"https:\/\/demo.7iquid.com\/alsha\/wp-content\/uploads\/2026\/05\/testimonialImage.webp 736w, https:\/\/demo.7iquid.com\/alsha\/wp-content\/uploads\/2026\/05\/testimonialImage-207x300.webp 207w, https:\/\/demo.7iquid.com\/alsha\/wp-content\/uploads\/2026\/05\/testimonialImage-706x1024.webp 706w, https:\/\/demo.7iquid.com\/alsha\/wp-content\/uploads\/2026\/05\/testimonialImage-386x560.webp 386w\" sizes=\"(max-width: 736px) 100vw, 736px\" \/><\/div>\n            <div class=\"item-content-wrap\">\n                <div class=\"item-title\">Delivery &amp; Execution<\/div>\n                <div class=\"item-description\">The design vision is carefully translated into reality through detailed documentation and close coordination with consultants and builders. We ensure that every element.<\/div>\n                <div class=\"item-list\"><ul>\n<li>Construction Documentation &amp; Technical Drawings<\/li>\n<li>Consultant &amp; Contractor Coordination<\/li>\n<li>Site Supervision &amp; Design Implementation<\/li>\n<\/ul><\/div>\n            <\/div>\n        <\/div>\n            <div class=\"process-item\"> \n            <div class=\"item-count\">04<\/div>\n            <div class=\"featured-image\"><img loading=\"lazy\" decoding=\"async\" width=\"1289\" height=\"387\" src=\"https:\/\/demo.7iquid.com\/alsha\/wp-content\/uploads\/2026\/04\/contnact-image-4.webp\" class=\"attachment-full size-full wp-image-372\" alt=\"\" srcset=\"https:\/\/demo.7iquid.com\/alsha\/wp-content\/uploads\/2026\/04\/contnact-image-4.webp 1289w, https:\/\/demo.7iquid.com\/alsha\/wp-content\/uploads\/2026\/04\/contnact-image-4-300x90.webp 300w, https:\/\/demo.7iquid.com\/alsha\/wp-content\/uploads\/2026\/04\/contnact-image-4-1024x307.webp 1024w, https:\/\/demo.7iquid.com\/alsha\/wp-content\/uploads\/2026\/04\/contnact-image-4-768x231.webp 768w, https:\/\/demo.7iquid.com\/alsha\/wp-content\/uploads\/2026\/04\/contnact-image-4-1170x351.webp 1170w\" sizes=\"(max-width: 1289px) 100vw, 1289px\" \/><\/div>\n            <div class=\"item-content-wrap\">\n                <div class=\"item-title\">Review &amp; Refinement<\/div>\n                <div class=\"item-description\">Each project is continuously reviewed through critical evaluation and feedback. We refine details, improve performance, and ensure the final outcome achieves.<\/div>\n                <div class=\"item-list\"><ul>\n<li>Design Quality Review<\/li>\n<li>Detail &amp; Material Refinement<\/li>\n<li>Post-Completion Evaluation<\/li>\n<\/ul><\/div>\n            <\/div>\n        <\/div>\n    <\/div>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-f9d865a e-flex e-con-boxed e-con e-parent\" data-id=\"f9d865a\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-178eec9 e-flex e-con-boxed e-con e-child\" data-id=\"178eec9\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-7b8a02b e-con-full e-grid e-con e-child\" data-id=\"7b8a02b\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-837eb87 elementor-widget elementor-widget-alsha_title\" data-id=\"837eb87\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"alsha_title.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"alsha-title-el\" data-split=\"none\" data-animate=\"none\" data-delay=\"0\" data-animateDuration=\"0.8\" data-stagger=\"0\" data-ease=\"none\">\r\n    <h2 class=\"title-text\">Post-Design<\/h2><\/div>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-23027dc elementor-widget__width-initial elementor-widget-mobile_extra__width-inherit elementor-widget elementor-widget-alsha_text_editor\" data-id=\"23027dc\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"alsha_text_editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\n<div class=\"alsha-text-editor-el elementor-clearfix\">\n    <p>We like to shepherd our designs from drawing to reality, and to help our clients through this journey.<\/p><\/div>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-elem